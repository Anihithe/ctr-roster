# ==============================================================================
# CTR-Roster - Configuration Environnement : PRODUCTION
# Copier ce fichier vers '.env' dans votre dossier de production (/opt/ctr-roster/)
# ==============================================================================

# Nom du conteneur Docker (garantit l'absence de conflit avec la dev)
CONTAINER_NAME=ctr_roster_prod

# Politique de redémarrage (tourne 24/7, redémarre automatiquement au reboot du Raspberry Pi)
RESTART_POLICY=unless-stopped

# Environnement ASP.NET Core
DOTNET_ENVIRONMENT=Production

# Token Discord de votre Bot de PRODUCTION (depuis Discord Developer Portal)
DISCORD_BOT_TOKEN=METTRE_VOTRE_TOKEN_DE_PRODUCTION_ICI

# [Optionnel] ID de rôle ou d'utilisateur administrateur global
DISCORD_ADMIN_ROLE_ID=0
DISCORD_ADMIN_USER_ID=0

# Nom du fichier SQLite (stocké dans ./data/)
SQLITE_DB_NAME=ctr_roster.db
