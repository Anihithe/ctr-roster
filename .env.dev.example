# ==============================================================================
# CTR-Roster - Configuration Environnement : DÉVELOPPEMENT / TEST
# Copier ce fichier vers '.env' dans votre dossier de dev (/opt/ctr-roster-dev/)
# ==============================================================================

# Nom du conteneur Docker (distinct de la production)
CONTAINER_NAME=ctr_roster_dev

# Politique de redémarrage ('no' = ne démarre pas au reboot, démarrage uniquement à la demande)
RESTART_POLICY=no

# Environnement ASP.NET Core
DOTNET_ENVIRONMENT=Development

# Token Discord de votre Bot de DÉVELOPPEMENT (depuis Discord Developer Portal)
DISCORD_BOT_TOKEN=METTRE_VOTRE_TOKEN_DE_DEV_ICI

# [Optionnel] ID du serveur Discord de dev pour enregistrement instantané des slash commands
DISCORD_DEV_GUILD_ID=0

# [Optionnel] ID de rôle ou d'utilisateur administrateur de test
DISCORD_ADMIN_ROLE_ID=0
DISCORD_ADMIN_USER_ID=0

# Nom du fichier SQLite (stocké dans ./data/)
SQLITE_DB_NAME=ctr_roster_dev.db
